/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_DAC_Init();
  MX_USART1_UART_Init();
  MX_USART2_UART_Init();
  MX_USART3_UART_Init();
  MX_TIM1_Init();
  MX_TIM6_Init();
  /* USER CODE BEGIN 2 */
  // Tabla de la senoidal (ecuacion de clase)
  for (int i = 0; i < NS; i++)
  {
	  sine_val[i] = ((sin(i * 2 * PI / NS) + 1) * (4096 / 2));
	  if (sine_val[i] > 4095) sine_val[i] = 4095;    // maximo de 12 bits
  }
  // Como en el ejemplo DAC-DMA de clase: el DAC + DMA se inicia una sola vez.
  // Las notas se generan cambiando el periodo del TIM6 (ver playTone).
  HAL_DAC_Start_DMA(&hdac, DAC_CHANNEL_1, sine_val, NS, DAC_ALIGN_12B_R);

  NeoPixel_Color(0, 0, 255, 40);     // azul tenue: sistema encendido / en espera

  UART_Print("MENU PRINCIPAL\r\n");
  UART_Print(" 1. Obtener medicion de temperatura\r\n");
  UART_Print(" 2. Guardar ultima medicion en la SD\r\n");
  UART_Print("(Tambien se puede mandar desde el celular)\r\n\r\n");
  /* USER CODE END 2 */

  /* Initialize leds */
  BSP_LED_Init(LED2);

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
	  // ---------- 1) Revisar si llego un comando ----------
	  comando = 0;
	  if (HAL_UART_Receive(&huart2, &comando, 1, 10) != HAL_OK)      // de la PC
	  {
		  if (HAL_UART_Receive(&huart3, &comando, 1, 10) != HAL_OK)  // del ESP32
		  {
			  comando = 0;                     // no llego nada
		  }
	  }

	  // Se acepta el caracter '1' o el valor 1 (igual con el 2)
	  if (comando == 1) comando = '1';
	  if (comando == 2) comando = '2';

	  huboError = 0;

	  // ---------- 2) Comando de LECTURA ----------
	  if (comando == '1')
	  {
		  NeoPixel_Color(255, 180, 0, 100);    // amarillo: adquiriendo
		  playTone(notas_comando, dur_comando, sizeof(notas_comando) / sizeof(notas_comando[0]));
		  UART_Print("Solicitando medicion a Nucleo 2...\r\n");

		  while (HAL_UART_Receive(&huart1, &basura, 1, 5) == HAL_OK);   // vacia bytes viejos
		  HAL_UART_Transmit(&huart1, &leern2, 1, 100);   // pide la lectura a la Nucleo 2

		  if (HAL_UART_Receive(&huart1, (uint8_t*)&temperatura, sizeof(temperatura), 1000) == HAL_OK)
		  {
			  // PRUEBA: muestra los 4 bytes tal como llegaron de la Nucleo 2 (borrar despues)
			  uint8_t *b = (uint8_t*)&temperatura;
			  sprintf(mensaje, "Bytes recibidos: %d %d %d %d\r\n", b[0], b[1], b[2], b[3]);
			  UART_Print(mensaje);

			  hayMedicion = 1;                     // ya hay una medicion valida para guardar
			  NeoPixel_Color(127, 0, 255, 100);    // morado: transmitiendo a la PC
			  int entero  = (int)temperatura;
			  int decimal = abs((int)((temperatura - entero) * 100));
			  sprintf(mensaje, "Temperatura: %d.%02d C\r\n\r\n", entero, decimal);
			  UART_Print(mensaje);                                              // a la PC

			  sprintf(mensaje, "Temperatura: %d.%02d C\n", entero, decimal);
			  HAL_UART_Transmit(&huart3, (uint8_t*) mensaje, strlen(mensaje), 100);   // al ESP32
			  HAL_Delay(300);                      // para que se alcance a ver el morado

			  // Color y sonido segun el rango de temperatura
			  if (temperatura < 35.0)              // hipotermia
			  {
				  NeoPixel_Color(0, 0, 255, 100);  // azul fuerte
				  playTone(notas_hipotermia, dur_hipotermia, sizeof(notas_hipotermia) / sizeof(notas_hipotermia[0]));
			  }
			  else if (temperatura < 37.5)         // normal
			  {
				  NeoPixel_Color(0, 255, 0, 100);  // verde
				  playTone(notas_normal, dur_normal, sizeof(notas_normal) / sizeof(notas_normal[0]));
			  }
			  else if (temperatura < 38.0)         // febricula
			  {
				  NeoPixel_Color(255, 80, 0, 100); // naranja
				  playTone(notas_febricula, dur_febricula, sizeof(notas_febricula) / sizeof(notas_febricula[0]));
			  }
			  else                                 // fiebre
			  {
				  NeoPixel_Color(255, 0, 0, 100);  // rojo
				  playTone(notas_fiebre, dur_fiebre, sizeof(notas_fiebre) / sizeof(notas_fiebre[0]));
			  }
			  HAL_Delay(2000);                     // deja el color del resultado 2 s
		  }
		  else
		  {
			  UART_Print("ERROR: Nucleo 2 no respondio\r\n\r\n");
			  huboError = 1;
		  }
	  }

	  // ---------- 3) Comando de GUARDADO ----------
	  else if (comando == '2')
	  {
		  NeoPixel_Color(255, 180, 0, 100);    // amarillo: procesando
		  playTone(notas_comando, dur_comando, sizeof(notas_comando) / sizeof(notas_comando[0]));

		  if (hayMedicion == 0)                // no se guarda si no hay medicion valida
		  {
			  UART_Print("ERROR: no hay medicion para guardar, primero haga una lectura\r\n\r\n");
			  HAL_UART_Transmit(&huart3, &guardadoError, 1, 100);   // avisa al ESP32: no se guardo
			  huboError = 1;
		  }
		  else
		  {
			  UART_Print("Guardando ultima medicion en la SD...\r\n");
			  while (HAL_UART_Receive(&huart1, &basura, 1, 5) == HAL_OK);   // vacia bytes viejos
			  HAL_UART_Transmit(&huart1, &guardarn2, 1, 100);    // pide guardar a la Nucleo 2

			  // espera la respuesta de la Nucleo 2 (la SD puede tardar un poco)
			  if (HAL_UART_Receive(&huart1, &respuesta, 1, 2000) != HAL_OK)
			  {
				  respuesta = 0;                   // la Nucleo 2 no respondio
			  }
			  // PRUEBA: muestra la respuesta tal como llego de la Nucleo 2 (borrar despues)
			  sprintf(mensaje, "Respuesta de Nucleo 2: %d\r\n", respuesta);
			  UART_Print(mensaje);

			  if (respuesta == 3) respuesta = '3';     // se acepta el valor 3 o el caracter '3'

			  if (respuesta == '3')                // la Nucleo 2 confirma que se guardo
			  {
				  UART_Print("Medicion guardada correctamente en la SD\r\n\r\n");
				  HAL_UART_Transmit(&huart3, &guardadoOK, 1, 100);      // avisa al ESP32: guardado
				  for (int i = 0; i < 2; i++)      // verde: 2 destellos
				  {
					  NeoPixel_Color(0, 255, 0, 100);
					  HAL_Delay(150);
					  NeoPixel_Color(0, 0, 0, 0);
					  HAL_Delay(150);
				  }
				  playTone(notas_guardado, dur_guardado, sizeof(notas_guardado) / sizeof(notas_guardado[0]));
			  }
			  else
			  {
				  UART_Print("ERROR: no se pudo guardar en la SD\r\n\r\n");
				  HAL_UART_Transmit(&huart3, &guardadoError, 1, 100);   // avisa al ESP32: no se guardo
				  huboError = 1;
			  }
		  }
	  }

	  // ---------- 4) Si algo fallo: alarma "Meeeg" con el LED en rojo ----------
	  if (huboError == 1)
	  {
		  for (int i = 0; i < 3; i++)
		  {
			  NeoPixel_Color(255, 0, 0, 100);  // rojo encendido
			  playTone(notas_error, dur_error, sizeof(notas_error) / sizeof(notas_error[0]));
			  NeoPixel_Color(0, 0, 0, 0);      // apagado
			  HAL_Delay(150);
		  }
	  }

	  // ---------- 5) Despues de cada comando: volver a espera ----------
	  if (comando == '1' || comando == '2')
	  {
		  NeoPixel_Color(0, 0, 255, 40);       // azul tenue: en espera
		  UART_Print("Esperando comando (1 = lectura, 2 = guardar)...\r\n\r\n");
	  }
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

