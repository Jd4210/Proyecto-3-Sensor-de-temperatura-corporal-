/* ----------------------- NeoPixel ----------------------- */
// Cambia el color del LED (r, g, b de 0 a 255; brillo de 0 a 100)
// Misma logica que pixelShow() y Gamma_correccion() de la libreria del profe
void NeoPixel_Color(uint8_t r, uint8_t g, uint8_t b, float brillo)
{
	uint8_t colores[3] = {g, r, b};   // el WS2812 recibe en orden G, R, B
	uint32_t color = 0;
	uint32_t indx = 0;

	// 1) Brillo y correccion gamma a cada color, y se juntan en 24 bits
	for (int c = 0; c < 3; c++)
	{
		float ajustado = colores[c] * (brillo / 100.0f);
		float corregido = pow(ajustado / 255.0f, GAMMA) * 255.0f;
		if (corregido > 255.0f) corregido = 255.0f;
		color = (color << 8) | (uint8_t) corregido;
	}

	// 2) Cada bit se convierte en un ancho de pulso
	for (int bit = 23; bit >= 0; bit--)
	{
		if (color & (1 << bit)) pwmData[indx] = CCR_1;   // un "1"
		else                    pwmData[indx] = CCR_0;   // un "0"
		indx++;
	}

	// 3) Reset: 50 periodos en bajo
	for (int i = 0; i < 50; i++)
	{
		pwmData[indx] = 0;
		indx++;
	}

	// 4) Se mandan por PWM + DMA y se espera a que termine
	HAL_TIM_PWM_Start_DMA(&htim1, TIM_CHANNEL_1, (uint32_t*) pwmData, indx);
	while (!datasentflag);
	datasentflag = 0;
}

/* ------------------------ Sonido ------------------------ */
// Toca un arreglo de notas con sus duraciones en ms (como playTone de clase).
// El DAC + DMA ya estan encendidos (USER CODE 2); para cada nota solo se cambia
// el periodo (ARR) del TIM6, que es quien dispara al DAC.
void playTone(uint16_t *notas, uint16_t *duraciones, int cantidad)
{
	for (int i = 0; i < cantidad; i++)
	{
		if (notas[i] == SILENCIO)
		{
			HAL_TIM_Base_Stop(&htim6);              // sin disparos: el DAC no cambia (silencio)
		}
		else
		{
			// periodo del TIM6 para la nota: ARR = 84 MHz / (f * NS) - 1
			__HAL_TIM_SET_AUTORELOAD(&htim6, (F_TIMER / (notas[i] * NS)) - 1);
			HAL_TIM_Base_Start(&htim6);             // el TIM6 dispara al DAC: suena
		}
		HAL_Delay(duraciones[i]);                   // duracion de la nota
	}
	HAL_TIM_Base_Stop(&htim6);                      // al terminar la melodia: silencio
}
